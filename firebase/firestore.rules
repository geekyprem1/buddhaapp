rules_version = '2';

// Dhamma Path — Firestore Security Rules
// See docs/ARCHITECTURE.md §7. Deny-by-default; admin writes gated by
// custom claims; content is public-read only when published.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() &&
        role() in ['super_admin', 'content_manager', 'moderator'];
    }

    function isSuperAdmin() {
      return isSignedIn() && role() == 'super_admin';
    }

    function isContentEditor() {
      return isSignedIn() && role() in ['super_admin', 'content_manager'];
    }

    // --- Users ---
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Owner may write their own doc but never flip isBlocked, set a role, or
      // grant themselves premium — entitlement fields are written only by the
      // verifyPurchase / RTDN Cloud Functions (admin SDK bypasses rules).
      // Create must not seed entitlement fields either (B1): `resource`
      // doesn't exist on create, so the incoming keys are checked directly.
      // The client model never sends these (Functions use the Admin SDK and
      // bypass rules). `isBlocked` is intentionally allowed here — the client
      // seeds it as false on first write and flipping it only harms/equals self.
      allow create: if isOwner(uid) &&
                        !request.resource.data.keys()
                          .hasAny(['premiumUntil', 'premiumToken',
                                   'premiumState', 'premiumUpdatedAt']);
      allow update: if (isOwner(uid) &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['isBlocked', 'premiumUntil', 'premiumToken',
                                   'premiumState', 'premiumUpdatedAt'])) ||
                       isAdmin();
      allow delete: if false; // deletion is via processDeletionRequest Function only

      match /alarms/{alarmId} {
        allow read, write: if isOwner(uid);
      }
      match /favourites/{itemId} {
        allow read, write: if isOwner(uid);
      }
      match /progress/{itemId} {
        allow read, write: if isOwner(uid);
      }
    }

    // --- Teachers & Categories ---
    match /teachers/{teacherId} {
      allow read: if isSignedIn() && (resource.data.isActive == true || isAdmin());
      allow write: if isContentEditor();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn() && (resource.data.isActive == true || isAdmin());
      allow write: if isContentEditor();
    }

    match /wisdoms/{wisdomId} {
      allow read: if isSignedIn() && (resource.data.isActive == true || isAdmin());
      allow write: if isContentEditor();
    }

    match /homeBanners/{bannerId} {
      allow read: if isSignedIn() && (resource.data.isActive == true || isAdmin());
      allow write: if isContentEditor();
    }

    match /videos/{videoId} {
      allow read: if isSignedIn() && (resource.data.isActive == true || isAdmin());
      allow write: if isContentEditor();
    }

    match /places/{placeId} {
      allow read: if isSignedIn() && (resource.data.isActive == true || isAdmin());
      allow write: if isContentEditor();
    }

    // --- Content collections (wallpapers, ringtones, songs, vandanas,
    //     meditations, chantings, statuses, prarthanas) share the same
    //     shape and rules.
    //     Firestore rules can't parameterise the collection name itself in
    //     a single match block, so the same rule body is repeated per
    //     collection via this function + one match block each. ---
    // Read rule uses ONLY `status` so list queries filtered by
    // `status == 'published'` are provably safe (Firestore rejects a list
    // query whose rule references fields the query doesn't constrain — so a
    // `deletedAt == null` clause here would break every list). Soft-delete
    // therefore also flips status to 'archived' (see ContentRepository),
    // which removes the item from published reads.
    function contentCanRead() {
      return isSignedIn() &&
        (resource.data.status == 'published' || isAdmin());
    }

    function contentCanUpdate() {
      return isContentEditor() ||
        (
          isSignedIn() && role() == 'moderator' &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['counters']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'isFeatured', 'sortOrder', 'updatedAt'])
        );
    }

    function contentCanCreate() {
      // counters must always start at their default; clients never seed them.
      return isContentEditor();
    }

    match /wallpapers/{itemId} {
      allow read: if contentCanRead();
      allow create: if contentCanCreate();
      allow update: if contentCanUpdate() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['counters']);
      allow delete: if isSuperAdmin();
    }
    match /ringtones/{itemId} {
      allow read: if contentCanRead();
      allow create: if contentCanCreate();
      allow update: if contentCanUpdate() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['counters']);
      allow delete: if isSuperAdmin();
    }
    match /songs/{itemId} {
      allow read: if contentCanRead();
      allow create: if contentCanCreate();
      allow update: if contentCanUpdate() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['counters']);
      allow delete: if isSuperAdmin();
    }
    match /vandanas/{itemId} {
      allow read: if contentCanRead();
      allow create: if contentCanCreate();
      allow update: if contentCanUpdate() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['counters']);
      allow delete: if isSuperAdmin();
    }
    match /meditations/{itemId} {
      allow read: if contentCanRead();
      allow create: if contentCanCreate();
      allow update: if contentCanUpdate() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['counters']);
      allow delete: if isSuperAdmin();
    }
    match /chantings/{itemId} {
      allow read: if contentCanRead();
      allow create: if contentCanCreate();
      allow update: if contentCanUpdate() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['counters']);
      allow delete: if isSuperAdmin();
    }
    match /statuses/{itemId} {
      allow read: if contentCanRead();
      allow create: if contentCanCreate();
      allow update: if contentCanUpdate() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['counters']);
      allow delete: if isSuperAdmin();
    }
    match /prarthanas/{itemId} {
      allow read: if contentCanRead();
      allow create: if contentCanCreate();
      allow update: if contentCanUpdate() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['counters']);
      allow delete: if isSuperAdmin();
    }

    // --- Phase 2 collections (reserved) ---
    match /idCardTemplates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isContentEditor();
    }
    match /idCards/{cardId} {
      allow read: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      // Split create/update/delete (B4): a single `write` rule checking only
      // the *new* data let anyone overwrite someone else's card by stamping
      // their own uid on it — and `request.resource` is null on delete, so a
      // combined rule denied owners their own deletes too.
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.uid == request.auth.uid;
    }

    // --- Config & static content ---
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
    match /staticPages/{slug} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // --- Admin & audit ---
    match /adminUsers/{uid} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Functions only, via the Admin SDK
    }

    // --- Notifications ---
    match /notifications/{campaignId} {
      allow read: if isAdmin();
      allow create: if isContentEditor();
      allow update: if isContentEditor();
      allow delete: if isSuperAdmin();
    }

    // --- Events (write-only counters feed) ---
    // Shape-validated (B15): unsigned junk docs used to cost a read+delete
    // every 5 minutes in `aggregateEvents`. The allowlists mirror
    // `CONTENT_COLLECTIONS` and `EVENT_TYPE_TO_COUNTER` in
    // functions/src/lib/content.ts — keep them in sync.
    match /events/{eventId} {
      allow create: if isSignedIn() &&
        request.resource.data.collection in ['wallpapers', 'ringtones',
          'songs', 'vandanas', 'meditations', 'chantings', 'statuses',
          'prarthanas'] &&
        request.resource.data.type in ['view', 'views', 'download',
          'downloads', 'share', 'shares', 'play', 'plays', 'song_play',
          'song_complete', 'vandana_play', 'vandana_complete'] &&
        request.resource.data.itemId is string &&
        request.resource.data.itemId.size() > 0 &&
        request.resource.data.itemId.size() <= 300 &&
        !request.resource.data.itemId.matches('.*/.*') &&
        request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }

    // --- OTP abuse guard (Functions only; FR-2.9, T2.11) ---
    match /otpGuards/{phoneKey} {
      allow read, write: if false;
    }
    // --- Per-IP OTP throttle (Functions only; B2) ---
    match /otpGuardsByIp/{ipKey} {
      allow read, write: if false;
    }

    // --- Bodhi AI daily quota (Functions only; bodhi-ai-chat spec) ---
    // Counters must be untouchable by the client, or a user could reset
    // their own daily allowance. Written by bodhiChat / bodhiSession via the
    // Admin SDK, which bypasses rules.
    match /aiUsage/{usageId} {
      allow read, write: if false;
    }

    // --- Purchase token ownership (Functions only; N7) ---
    // Maps a Play purchase token to exactly one app uid so a token cannot
    // grant premium to multiple accounts. Written by verifyPurchase via the
    // Admin SDK, which bypasses rules.
    match /purchaseTokens/{tokenId} {
      allow read, write: if false;
    }

    // --- Contact & deletion requests ---
    match /contactMessages/{msgId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    match /deletionRequests/{uid} {
      allow create: if isOwner(uid);
      allow read: if isOwner(uid) || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
